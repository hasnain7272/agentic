# Project Kernel Runtime - Environment Configuration
# Copy this file to .env and customize for your deployment

# ===========================================
# CORE SETTINGS
# ===========================================

# Environment: development | staging | production
ENVIRONMENT=development

# Application secret key (generate with: openssl rand -hex 32)
APP_SECRET_KEY=change-me-in-production-generate-a-secure-key

# JWT secret for token signing (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-key-change-me-in-production

# ===========================================
# DATABASE
# ===========================================

# SQLite (simplest, good for small deployments)
DATABASE_URL=sqlite:///data/kernel.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/kernel

# ===========================================
# REDIS
# ===========================================

# For local development without Redis:
REDIS_URL=

# With Redis (recommended):
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# LLM CONFIGURATION (BYOK - Bring Your Own Key)
# ===========================================

# Default model (users can override per-session)
DEFAULT_MODEL=gpt-4o

# Optional: Default API key (users can still use their own)
# OPENAI_API_KEY=sk-...

# Optional: OpenRouter for multiple models
# OPENROUTER_API_KEY=sk-or-...

# ===========================================
# AUTHENTICATION
# ===========================================

# Allow anonymous access in local development
ALLOW_ANON_LOCAL=true

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ===========================================
# CORS
# ===========================================

# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Production (update with your domain):
# CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# ===========================================
# WORKER CONFIGURATION
# ===========================================

# Run worker in same process (development)
HYBRID_MODE=true

# Separate worker processes (production):
# HYBRID_MODE=false

# ===========================================
# OBSERVABILITY
# ===========================================

# OpenTelemetry (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector.com
# OTEL_SERVICE_NAME=kernel-runtime

# ===========================================
# BILLING (When you add paid plans)
# ===========================================

# Stripe (optional)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ===========================================
# SECURITY
# ===========================================

# Kubernetes namespace for sandbox execution
K8S_NAMESPACE=default

# Sandbox timeout (seconds)
K8S_TIMEOUT=120

# ===========================================
# FEATURE FLAGS
# ===========================================

# Enable new features
ENABLE_GIT_INTEGRATION=true
ENABLE_ANALYSIS_TOOLS=true

# ===========================================
# ADVANCED
# ===========================================

# Max file upload size (bytes)
MAX_UPLOAD_SIZE=10485760

# Session timeout (seconds)
SESSION_TIMEOUT=3600

# Rate limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=500
